# Rust
target/
**/*.rs.bk
# Cargo.lock IS committed: this workspace ships a deployable node (vertex_node),
# so locked, reproducible builds are preferred over floating versions.
# Exception: vertex_ros2's lockfile is generated by the in-container colcon build
# and pins colcon-only deps (rclrs = "*") that don't resolve outside colcon.
vertex_ros2/Cargo.lock

# colcon / ROS 2
build/
install/
log/

# Python (launch_test bytecode)
**/__pycache__/

# Generated test keypairs (contains secret keys — never commit; regenerate via
# vertex_ros2/test/gen_test_keys.sh)
vertex_ros2/test/fixtures/

# OS
.DS_Store
