# Workspace bootstrap for consumers (and CI). From an empty workspace directory:
#
#   mkdir src
#   vcs import src < tessera.repos
#
# This repo is the only checkout needed. `vertex_core` pins the `tashi-vertex`
# bindings to an exact version from crates.io, and that crate's build script
# downloads the matching tashi-vertex-c engine release, so there is no sibling
# checkout and no credentials beyond access to tessera itself.
repositories:
  tessera:
    type: git
    url: git@github.com:tashigit/tessera.git
    version: main
