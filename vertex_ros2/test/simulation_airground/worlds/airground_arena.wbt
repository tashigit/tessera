WorldInfo {
  # The Mavic 2 PRO's published control constants assume these. The arena
  # world left WorldInfo empty, which is fine for Pioneers but leaves the
  # drones unflyable: at the default 32 ms step with no damping the attitude
  # loop oscillates and they tumble on takeoff.
  basicTimeStep 8
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
