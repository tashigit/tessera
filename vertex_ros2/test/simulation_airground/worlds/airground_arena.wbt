DEF DRONE_0 Mavic2Pro {
  translation -20 -15 0.1
  rotation 0 0 1 0
  name "drone_0"
  controller "mavic_surveyor"
  bodySlot [
    # Downward ranger: the reason the air tier exists. A Pioneer's Sick LMS 291
    # is horizontal and cannot see a hole, so the arena's craters are invisible
    # from the ground. From above, a pit reads as ground that is further away
    # than the drone's altitude, which is a crisp geometric signal rather than
    # a vision problem. Mounted in bodySlot, an MFNode that sits directly in
    # the proto's Robot.children, so no derived proto is needed.
    DistanceSensor {
      name "ground_ranger"
      translation 0 0 -0.05
      rotation 0 1 0 1.5708          # point straight down (-Z)
      type "laser"
      numberOfRays 3
      aperture 0.05
      lookupTable [
        0    0    0
        40   40   0.002
      ]
    }
  ]
}
