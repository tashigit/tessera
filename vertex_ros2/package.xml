<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vertex_ros2</name>
  <version>0.3.0</version>
  <description>
    ROS 2 node integrating the Tashi Vertex hashgraph BFT consensus engine.
    Submit opaque bytes on /vertex/tx and receive a totally-ordered, final
    consensus stream on /vertex/event.
  </description>
  <maintainer email="yeousunn@tashi.network">Tashi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cargo</buildtool_depend>

  <depend>rclrs</depend>
  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vertex_ros2_msgs</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
